import pandas as pd
import matplotlib.pyplot as plt
data = pd.read_csv("module5/M5 Sales.csv")
print("===== RETAIL SALES DASHBOARD =====")
print(data)
total_sales = data["Sales"].sum()
print("\nTotal Sales:", total_sales)
print("\nSales by Product:")
print(data.groupby("Product")["Sales"].sum())
plt.bar(data["Product"], data["Sales"], color="skyblue")
plt.title("Retail Sales Dashboard")
plt.xlabel("Products")
plt.ylabel("Sales")
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
